# What this teaches / copy this pattern:
# Committed, NON-secret Vite build-time config for LOCAL DEV (default mode).
# Vite inlines `VITE_*` vars into the CLIENT bundle, so ONLY non-secret values
# belong here (never the `ah_sk_*` key - it lives in sessionStorage at runtime).
#
# `VITE_PERSISTENCE` selects the browser reservation store adapter and MUST agree
# with the Worker `PERSISTENCE` var (wrangler.jsonc). Local dev = `d1`: the store
# calls `/api/reservations`, which the D1-bound Worker serves. The deployed build
# uses `.env.production` (`VITE_PERSISTENCE=local`) instead.
VITE_PERSISTENCE=d1

# DEV-TEST-ONLY cell targeting. Set to "us" to point the SDK data-plane
# (collectUserInfo `apiBase` in the guest check-in collect step) at a non-production
# sdk-api instead of the pk-derived prod origin. Pairs with the Worker var
# `CHECKTIV_DEV_CELL=us` in `.dev.vars` (server mint origin). Leave UNSET for prod
# behavior; both the client and worker must be set to validate the submit path end
# to end against a non-production cell. Never set on the finalized public demo.
# VITE_CHECKTIV_DEV_CELL=us
